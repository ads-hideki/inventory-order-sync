{
  "name": "ichigen-sync",
  "version": "0.1.0",
  "description": "一元管理システム: teps-2から販売数・在庫を読み込み、必要発注数を計算してFirestoreへ同期（出荷依頼の同期も含む）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node sync.js",
    "dry": "node sync.js --dry-run",
    "rp": "node rp_sync.js",
    "rp:dry": "node rp_sync.js --dry-run",
    "rp:seed": "node rp_seed.js"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "adm-zip": "^0.5.16",
    "exceljs": "^4.4.0"
  }
}
